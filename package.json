{
  "name": "package-age-guard",
  "version": "1.2.1",
  "description": "Block npm packages that are too new - protect against supply chain attacks",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": null
    },
    "./package.json": "./package.json",
    "./pnpm": "./pnpm.cjs",
    "./pnpm.js": "./pnpm.cjs"
  },
  "bin": {
    "package-age-guard": "bin/cli.js",
    "pag": "bin/cli.js"
  },
  "files": [
    "index.js",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "pnpm.cjs",
    "registry.cjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "node --check index.js && node --check bin/cli.js && node --check pnpm.cjs && node --check registry.cjs && node --check .github/actions/check-packages/run.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run test:package",
    "test:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "package",
    "age",
    "audit",
    "malware",
    "typosquatting",
    "ci",
    "devops",
    "protection",
    "registry"
  ],
  "author": "Meon Valley Web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeonValleyWeb/package-age-guard.git"
  },
  "bugs": {
    "url": "https://github.com/MeonValleyWeb/package-age-guard/issues"
  },
  "homepage": "https://github.com/MeonValleyWeb/package-age-guard#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {},
  "dependencies": {}
}
